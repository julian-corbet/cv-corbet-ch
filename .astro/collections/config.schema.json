{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "folder": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              }
            },
            "required": [
              "folder",
              "title",
              "icon"
            ]
          }
        },
        "special": {
          "type": "object",
          "properties": {
            "downloads": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "icon": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "icon"
              ]
            }
          }
        }
      },
      "required": [
        "sections"
      ]
    },
    {
      "type": "object",
      "properties": {
        "header": {
          "type": "object",
          "properties": {
            "phone": {
              "type": "string"
            },
            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "location": {
              "type": "string"
            }
          },
          "required": [
            "phone",
            "email",
            "location"
          ]
        },
        "social": {
          "type": "object",
          "properties": {
            "calendar": {
              "type": "string",
              "format": "uri"
            },
            "signal": {
              "type": "string",
              "format": "uri"
            },
            "whatsapp": {
              "type": "string",
              "format": "uri"
            },
            "telegram": {
              "type": "string",
              "format": "uri"
            },
            "linkedin": {
              "type": "string",
              "format": "uri"
            },
            "threema": {
              "type": "string",
              "format": "uri"
            },
            "x": {
              "type": "string",
              "format": "uri"
            },
            "matrix": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      },
      "required": [
        "header",
        "social"
      ]
    },
    {
      "type": "object",
      "properties": {
        "downloads": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "button": {
                    "type": "string"
                  },
                  "filename": {
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "filename"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "folder"
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "children": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "title": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "button": {
                          "type": "string"
                        },
                        "filename": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "title",
                        "filename"
                      ]
                    }
                  }
                },
                "required": [
                  "type",
                  "title",
                  "children"
                ]
              }
            ]
          }
        }
      },
      "required": [
        "downloads"
      ]
    },
    {
      "type": "object",
      "properties": {
        "page": {
          "type": "object",
          "properties": {
            "page_title": {
              "type": "string"
            },
            "page_subtitle": {
              "type": "string"
            },
            "page_description": {
              "type": "string"
            },
            "page_lang": {
              "default": "en",
              "type": "string"
            }
          },
          "required": [
            "page_title"
          ]
        },
        "seo": {
          "type": "object",
          "properties": {
            "seo_title": {
              "type": "string"
            },
            "seo_description": {
              "type": "string"
            },
            "seo_canonical_url": {
              "type": "string",
              "format": "uri"
            },
            "seo_keywords": {
              "minItems": 3,
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "seo_author": {
              "type": "string"
            },
            "seo_site_name": {
              "type": "string"
            },
            "seo_noindex": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "seo_title",
            "seo_description",
            "seo_canonical_url",
            "seo_keywords",
            "seo_author",
            "seo_site_name"
          ]
        },
        "og": {
          "type": "object",
          "properties": {
            "og_type": {
              "default": "website",
              "type": "string",
              "enum": [
                "website",
                "profile"
              ]
            },
            "og_title": {
              "type": "string"
            },
            "og_description": {
              "type": "string"
            },
            "og_url": {
              "type": "string",
              "format": "uri"
            },
            "og_site_name": {
              "type": "string"
            },
            "og_locale": {
              "default": "en_US",
              "type": "string"
            },
            "og_images": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "width": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "height": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "alt": {
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "width",
                  "height"
                ]
              }
            },
            "og_image_path": {
              "type": "string"
            },
            "og_image_width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "og_image_height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "profile_first_name": {
              "type": "string"
            },
            "profile_last_name": {
              "type": "string"
            },
            "profile_username": {
              "type": "string"
            },
            "profile_gender": {
              "type": "string"
            }
          },
          "required": [
            "og_title",
            "og_description",
            "og_url",
            "og_site_name"
          ]
        },
        "twitter": {
          "type": "object",
          "properties": {
            "twitter_card": {
              "default": "summary_large_image",
              "type": "string"
            },
            "twitter_title": {
              "type": "string"
            },
            "twitter_description": {
              "type": "string"
            },
            "twitter_site": {
              "type": "string"
            },
            "twitter_creator": {
              "type": "string"
            },
            "twitter_image_path": {
              "type": "string"
            }
          },
          "required": [
            "twitter_title",
            "twitter_description",
            "twitter_image_path"
          ]
        },
        "person": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "alternateName": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "jobTitle": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "image": {
              "type": "string",
              "format": "uri"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "sameAs": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              }
            },
            "knowsAbout": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "hasOccupation": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "occupationLocation": {
                  "type": "object",
                  "properties": {
                    "@type": {
                      "type": "string",
                      "const": "Country"
                    },
                    "name": {
                      "type": "string"
                    },
                    "addressCountry": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "@type",
                    "name"
                  ]
                }
              },
              "required": [
                "name",
                "occupationLocation"
              ]
            },
            "contactPoint": {
              "type": "object",
              "properties": {
                "@type": {
                  "type": "string",
                  "const": "ContactPoint"
                },
                "telephone": {
                  "type": "string"
                },
                "email": {
                  "type": "string",
                  "format": "email",
                  "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                },
                "contactType": {
                  "type": "string"
                },
                "areaServed": {
                  "type": "string"
                },
                "availableLanguage": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                }
              },
              "required": [
                "@type"
              ]
            }
          },
          "required": [
            "name",
            "jobTitle",
            "description",
            "image",
            "url",
            "hasOccupation",
            "contactPoint"
          ]
        }
      },
      "required": [
        "seo",
        "og",
        "twitter",
        "person"
      ]
    }
  ]
}